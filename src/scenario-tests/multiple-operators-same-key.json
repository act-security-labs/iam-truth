{
  "description": "Policies that reference one condition key with more than one operator",
  "cases": [
    {
      "name": "generates non-redundant rows for Null false and StringNotEquals on the same key",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyWithoutExpectedSourceIdentity",
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "Null": {
                  "aws:SourceIdentity": "false"
                },
                "StringNotEquals": {
                  "aws:SourceIdentity": "required-source-identity"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:SourceIdentity",
              "label": "aws:SourceIdentity",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            ["required-source-identity", "notDenied"],
            ["bob", "explicitlyDenied"],
            [null, "notDenied"]
          ]
        }
      }
    },
