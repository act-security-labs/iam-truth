    {
      "name": "generates non-redundant rows for Null false and ForAnyValue StringEquals on the same key",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyMatchingPrincipalOrgPath",
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "Null": {
                  "aws:PrincipalOrgPaths": "false"
                },
                "ForAnyValue:StringEquals": {
                  "aws:PrincipalOrgPaths": "o-example/r-root/ou-example/"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:PrincipalOrgPaths",
              "label": "Principal Org Paths",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            [["o-otherorg/r-root/ou-root-sandbox/"], "notDenied"],
            [
              ["o-example/r-root/ou-example/", "o-otherorg/r-root/ou-root-sandbox/"],
              "explicitlyDenied"
            ],
            [["o-example/r-root/ou-example/"], "explicitlyDenied"]
          ]
        }
      }
