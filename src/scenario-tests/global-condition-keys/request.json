          "columns": [
            {
              "key": "aws:CalledVia",
              "label": "aws:CalledVia",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            [["other.amazonaws.com"], "notDenied"],
            [["s3.amazonaws.com", "other.amazonaws.com"], "explicitlyDenied"],
            [["s3.amazonaws.com"], "explicitlyDenied"],
            [null, "notDenied"]
          ]
        }
      }
    },
