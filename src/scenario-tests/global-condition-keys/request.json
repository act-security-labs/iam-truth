    {
      "name": "global condition key aws:CalledVia",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "ForAnyValue:StringEqualsIfExists": {
                  "aws:CalledVia": ["s3.amazonaws.com"]
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
