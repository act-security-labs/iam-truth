              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            [["cloud-copilot-other-value"], "notDenied"],
            [["cloud-copilot-example-value", "cloud-copilot-other-value"], "explicitlyDenied"],
