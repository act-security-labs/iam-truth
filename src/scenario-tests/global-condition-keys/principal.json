{
  "description": "Global condition keys in principal category",
  "cases": [
    {
      "name": "global condition key aws:PrincipalArn",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "ArnEqualsIfExists": {
                  "aws:PrincipalArn": "arn:aws:iam::111111111111:role/TestRole"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:PrincipalArn",
              "label": "aws:PrincipalArn",
              "valueType": "arn"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            ["arn:aws:iam::111111111111:role/TestRole", "explicitlyDenied"],
            ["arn:aws:iam::222222222222:role/OtherRole", "notDenied"]
          ]
        }
      }
    },
