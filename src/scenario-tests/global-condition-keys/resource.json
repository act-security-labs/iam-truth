    {
      "name": "global condition key aws:ResourceOrgPaths",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "ForAnyValue:StringEqualsIfExists": {
                  "aws:ResourceOrgPaths": ["o-exampleorg/r-root/ou-root-security/"]
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:ResourceOrgPaths",
              "label": "Resource Organization Paths",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            [["o-otherorg/r-root/ou-root-sandbox/"], "notDenied"],
            [
              ["o-exampleorg/r-root/ou-root-security/", "o-otherorg/r-root/ou-root-sandbox/"],
              "explicitlyDenied"
            ],
            [["o-exampleorg/r-root/ou-root-security/"], "explicitlyDenied"],
            [null, "notDenied"]
          ]
        }
      }
