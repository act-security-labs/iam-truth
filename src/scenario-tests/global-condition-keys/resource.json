{
  "description": "Global condition keys in resource category",
  "cases": [
    {
      "name": "global condition key aws:ResourceAccount",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "StringEqualsIfExists": {
                  "aws:ResourceAccount": "111111111111"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:ResourceAccount",
              "label": "aws:ResourceAccount",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            ["111111111111", "explicitlyDenied"],
            ["222222222222", "notDenied"],
            [null, "explicitlyDenied"]
          ]
        }
      }
    },
