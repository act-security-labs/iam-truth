{
  "description": "Global condition keys in session category",
  "cases": [
    {
      "name": "global condition key aws:AssumedRoot",
      "input": {
        "policyType": "scp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "BoolIfExists": {
                  "aws:AssumedRoot": "true"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:PutObject"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:AssumedRoot",
              "label": "aws:AssumedRoot",
              "valueType": "boolean"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            [true, "explicitlyDenied"],
            [false, "notDenied"],
            [null, "explicitlyDenied"]
          ]
        }
      }
    },
