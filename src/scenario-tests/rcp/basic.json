{
  "description": "RCP support",
  "cases": [
    {
      "name": "RCP Allow statements are invalid",
      "input": {
        "policyType": "rcp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowRead",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "*"
            }
          ]
        },
        "request": {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::example-bucket/example.txt"
        }
      },
      "expected": {
        "resultType": "invalidPolicy",
        "diagnostics": {
          "includes": [
            {
              "code": "INVALID_POLICY",
              "severity": "error",
              "path": "Statement[0].Effect"
            }
          ]
        }
      }
    },
    {
      "name": "deny-only RCP with supported ResourceAccount action",
      "input": {
        "policyType": "rcp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyRead",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:ResourceAccount": "111111111111"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::example-bucket/example.txt"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "effectMode": "denyOnly",
          "testedAction": "s3:GetObject",
          "columns": [
            {
              "key": "aws:ResourceAccount",
              "label": "aws:ResourceAccount",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            ["111111111111", "explicitlyDenied"],
            ["222222222222", "notDenied"]
          ]
        }
      }
    },
    {
      "name": "RCP source account generates present and missing values",
      "input": {
        "policyType": "rcp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenySourceAccount",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "*",
              "Condition": {
                "StringEqualsIfExists": {
                  "aws:SourceAccount": "111111111111"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::example-bucket/example.txt"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:SourceAccount",
              "label": "aws:SourceAccount",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [
            ["111111111111", "explicitlyDenied"],
            ["222222222222", "notDenied"],
            [null, "explicitlyDenied"]
          ]
        }
      }
    },
    {
      "name": "RCP excluded action generates only missing resource-info keys",
      "input": {
        "policyType": "rcp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyMissingResourceInfo",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "ec2:CopySnapshot",
              "Resource": "*",
              "Condition": {
                "Null": {
                  "aws:ResourceAccount": "true",
                  "aws:ResourceOrgID": "true",
                  "aws:ResourceOrgPaths": "true"
                }
              }
            }
          ]
        },
        "request": {
          "action": "ec2:CopySnapshot",
          "resource": "*"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "columns": [
            {
              "key": "aws:ResourceAccount",
              "label": "aws:ResourceAccount",
              "valueType": "string"
            },
            {
              "key": "aws:ResourceOrgID",
              "label": "Organization ID",
              "valueType": "string"
            },
            {
              "key": "aws:ResourceOrgPaths",
              "label": "Resource Organization Paths",
              "valueType": "string"
            },
            {
              "key": "result",
              "label": "Result",
              "valueType": "result"
            }
          ],
          "rows": [[null, null, null, "explicitlyDenied"]]
        }
      }
    },
    {
      "name": "RCP action filtering only uses conditions from matching statements",
      "input": {
        "policyType": "rcp",
        "policy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyRead",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:ResourceAccount": "111111111111"
                }
              }
            },
            {
              "Sid": "DenyWrite",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "111111111111"
                }
              }
            }
          ]
        },
        "request": {
          "action": "s3:GetObject",
          "resource": "arn:aws:s3:::example-bucket/example.txt"
        },
        "options": {
          "maxRows": 1000
        }
      },
      "expected": {
        "resultType": "success",
        "table": {
          "testedAction": "s3:GetObject",
          "columnKeys": ["aws:ResourceAccount", "result"]
        }
      }
    }
  ]
}
